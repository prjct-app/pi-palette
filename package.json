{
  "name": "@prjct.app/pi-palette",
  "version": "0.4.8",
  "description": "34 Pi color themes as data: live preview, favorites, synced sessions, weekly versioned backups, and your own library from pi-themes by file or optional account sync.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "themes",
    "palette"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/prjct-app/pi-palette/main/docs/cover-v3.png"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prjct-app/pi-palette.git"
  },
  "bugs": {
    "url": "https://github.com/prjct-app/pi-palette/issues"
  },
  "homepage": "https://github.com/prjct-app/pi-palette#readme",
  "files": [
    "LICENSE",
    "README.md",
    "backup-ui.ts",
    "backup.ts",
    "cloud.ts",
    "favorites.ts",
    "index.ts",
    "library.ts",
    "migrate.ts",
    "palette-groups.ts",
    "palette-panel.ts",
    "palettes.json",
    "palettes.ts",
    "sync.ts",
    "docs/cover-v2.png",
    "docs/cover.png",
    "docs/cover-v3.png"
  ],
  "scripts": {
    "test": "export PI_CODING_AGENT_DIR=\"$(mktemp -d)\" PRJCT_HOME=\"$(mktemp -d)\" && node --import tsx --test --test-concurrency=1 *.test.ts *.test.mjs",
    "check:package": "npm pack --dry-run --ignore-scripts",
    "check": "tsc --noEmit",
    "build:pi": "node scripts/build-pi.mjs",
    "audit:runtime": "node scripts/audit-production.mjs"
  },
  "piBuild": {
    "copy": [
      "palettes.json"
    ]
  },
  "dependencies": {
    "@prjct.app/pi-tui-kit": "^0.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-tui": "1.0.3",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.0",
    "esbuild": "^0.28.1",
    "typebox": "1.3.7"
  }
}
